{
  "name": "proofline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run cloudflare:build",
    "validate": "node scripts/validate.mjs",
    "validate:release": "node scripts/validate.mjs --release",
    "score": "node scripts/score.mjs",
    "cloudflare:build": "npm ci --prefix site && npm --prefix site run build:cloudflare",
    "cloudflare:deploy": "site/node_modules/.bin/wrangler deploy --config wrangler.jsonc",
    "cloudflare:preview": "site/node_modules/.bin/wrangler versions upload --config wrangler.jsonc",
    "cloudflare:dry": "site/node_modules/.bin/wrangler deploy --dry-run --config wrangler.jsonc",
    "cloudflare:test": "npm run cloudflare:dry && npm --prefix site run cloudflare:smoke",
    "seed": "node scripts/seed-stubs.mjs",
    "test": "node scripts/validate.mjs && node scripts/test.mjs && node scripts/test-pipeline.mjs && node scripts/test-packet.mjs && node scripts/test-compile.mjs && node scripts/test-compile-inbox.mjs && node scripts/test-pull.mjs && node --test scripts/test-daily-registry.mjs scripts/test-activity-cache.mjs scripts/test-pipeline-health.mjs scripts/test-review-snapshot.mjs scripts/test-observation-audit.mjs scripts/test-pr-ci.mjs scripts/test-research-minimums.mjs && npm run test:signals",
    "audit:observations": "node scripts/audit-observations.mjs",
    "audit:research": "node scripts/audit-research.mjs",
    "test:research-minimums": "node --test scripts/test-research-minimums.mjs",
    "telegram": "node scripts/telegram-digest.mjs",
    "telegram:dry": "node scripts/telegram-digest.mjs --dry-run",
    "telegram:chat-id": "node scripts/telegram-chat-id.mjs",
    "telegram:test": "node scripts/telegram-digest.mjs --test",
    "telegram:mark-sent": "node scripts/telegram-digest.mjs --mark-sent",
    "compile:inbox": "node scripts/compile-inbox.mjs",
    "compile:inbox:dry": "node scripts/compile-inbox.mjs --dry",
    "pull": "node scripts/pull.mjs",
    "pull:dry": "node scripts/pull.mjs --dry",
    "test:pull": "node scripts/test-pull.mjs && node --test scripts/test-daily-registry.mjs scripts/test-activity-cache.mjs",
    "registry:plan": "node scripts/registry-plan.mjs",
    "test:signals": "node scripts/test-signals.mjs && node --test pulse/test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.0"
  }
}
