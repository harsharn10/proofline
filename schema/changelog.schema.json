{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "changelog",
  "type": "array",
  "$defs": {
    "channelPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event","delivery","headline","summary"],
      "properties": {
        "event": { "enum": ["new-coverage","research-update","risk-alert","correction","breaking","trending","roundup"] },
        "delivery": { "enum": ["immediate","same-day","roundup"] },
        "headline": { "type": "string", "minLength": 1, "maxLength": 180 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "why_it_matters": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "watch_next": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  },
  "items": { "type": "object", "additionalProperties": false,
    "required": ["date","slug","type","severity","title","detail","prior","new","reviewer","methodology_version"],
    "properties": {
      "date": { "type": "string", "format": "date" },
      "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "type": { "enum": ["score","risk","stage","finding","correction","coverage"] },
      "severity": { "enum": ["Info","Review","Material","Risk"] },
      "title": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 },
      "prior": { "type": ["object","null"] }, "new": { "type": ["object","null"] },
      "reviewer": { "type": "string", "minLength": 1 },
      "channel": { "$ref": "#/$defs/channelPublication" },
      "methodology_version": { "const": "proofline-v1.0" }
    } }
}
