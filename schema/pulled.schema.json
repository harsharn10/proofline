{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pulled",
  "title": "Pulled facts",
  "$comment": "Machine-owned output of scripts/pull.mjs. One file per census slug at content/pulled/<slug>.yaml, fully regenerated every run and never hand-edited. Address, chain and role vocabularies are shared with schema/shared.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "pulled_at", "chain", "addresses", "metrics", "errors"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "pulled_at": { "type": "string", "format": "date-time" },
    "chain": { "const": "robinhood-chain" },
    "addresses": { "type": "array", "items": { "$ref": "#/$defs/pulledAddress" } },
    "metrics": { "type": "array", "items": { "$ref": "#/$defs/pulledMetric" } },
    "market": { "oneOf": [{ "$ref": "#/$defs/pulledMarket" }, { "type": "null" }] },
    "structure": { "oneOf": [{ "$ref": "#/$defs/pulledStructure" }, { "type": "null" }] },
    "activity": { "oneOf": [{ "$ref": "#/$defs/pulledActivity" }, { "type": "null" }] },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/pullError" } }
  },
  "$defs": {
    "pullError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "message"],
      "properties": {
        "step": { "enum": ["rpc", "blockscout", "llama"] },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "pullStepError": {
      "$comment": "Same shape as pullError with a free-form step. The market and activity blocks name the step that failed rather than the producer that ran it — 'no token address', 'txns_24h capped' — because their failures are conditions, not endpoints. Keeping them off the pullError enum leaves the 34 existing files byte-compatible.",
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "message"],
      "properties": {
        "step": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "pulledAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address", "label", "role", "is_contract", "source_verified", "contract_name",
        "proxy", "owner", "owner_type", "safe", "created_block", "created_at", "holders", "errors"
      ],
      "properties": {
        "address": { "$ref": "shared#/$defs/address" },
        "label": { "type": ["string", "null"] },
        "role": { "$ref": "shared#/$defs/role" },
        "is_contract": { "type": ["boolean", "null"] },
        "source_verified": { "type": ["boolean", "null"] },
        "contract_name": { "type": ["string", "null"] },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "implementation", "admin"],
          "properties": {
            "type": { "enum": ["eip1967", "none", "unknown"] },
            "implementation": { "oneOf": [{ "$ref": "shared#/$defs/address" }, { "type": "null" }] },
            "admin": { "oneOf": [{ "$ref": "shared#/$defs/address" }, { "type": "null" }] }
          }
        },
        "owner": { "oneOf": [{ "$ref": "shared#/$defs/address" }, { "type": "null" }] },
        "owner_type": { "enum": ["eoa", "contract", "safe", "unknown", "none"] },
        "safe": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["threshold", "signers"],
              "properties": {
                "threshold": { "type": ["integer", "null"], "minimum": 0 },
                "signers": {
                  "oneOf": [
                    { "type": "array", "items": { "$ref": "shared#/$defs/address" } },
                    { "type": "null" }
                  ]
                }
              }
            },
            { "type": "null" }
          ]
        },
        "created_block": { "type": ["integer", "null"], "minimum": 0 },
        "created_at": { "type": ["string", "null"], "format": "date-time" },
        "holders": { "type": ["integer", "null"], "minimum": 0 },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/pullError" } }
      }
    },
    "pulledMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "as_of", "source_url"],
      "properties": {
        "kind": { "enum": ["tvl", "volume_24h", "fees_24h", "revenue_24h"] },
        "value": { "type": "number" },
        "as_of": { "type": "string", "format": "date-time" },
        "source_url": { "type": "string", "format": "uri" }
      }
    },
    "marketPair": {
      "$comment": "pair_address is an unconstrained string, not shared#/$defs/address: Uniswap v4 pools on this chain are identified by a 32-byte pool id rather than a 20-byte address.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dex", "pair_address", "quote_symbol", "price_usd", "liquidity_usd", "volume_h24",
        "volume_h6", "txns_h24", "price_change_h24", "fdv", "created_at"
      ],
      "properties": {
        "dex": { "type": ["string", "null"] },
        "pair_address": { "type": ["string", "null"] },
        "quote_symbol": { "type": ["string", "null"] },
        "price_usd": { "type": ["number", "null"] },
        "liquidity_usd": { "type": ["number", "null"] },
        "volume_h24": { "type": ["number", "null"] },
        "volume_h6": { "type": ["number", "null"] },
        "txns_h24": {
          "type": "object",
          "additionalProperties": false,
          "required": ["buys", "sells"],
          "properties": {
            "buys": { "type": "integer", "minimum": 0 },
            "sells": { "type": "integer", "minimum": 0 }
          }
        },
        "price_change_h24": { "type": ["number", "null"] },
        "fdv": { "type": ["number", "null"] },
        "created_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "pulledMarket": {
      "$comment": "DexScreener's view of the project's own token. liquidity_usd, volume_h24 and trades_h24 are sums over every pair; price_usd, price_change_h24 and fdv come from the single deepest pair, because a depth-blind average is a price nobody could trade at.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_address", "pulled_at", "pairs", "liquidity_usd", "volume_h24", "trades_h24",
        "price_usd", "price_change_h24", "fdv", "first_pair_at", "top10_share",
        "top10_share_ex_pools", "top10_as_of", "launchpad", "rialto", "pair_asset",
        "volume_disagreement", "errors"
      ],
      "properties": {
        "token_address": { "oneOf": [{ "$ref": "shared#/$defs/address" }, { "type": "null" }] },
        "pulled_at": { "type": "string", "format": "date-time" },
        "pairs": { "type": "array", "items": { "$ref": "#/$defs/marketPair" } },
        "liquidity_usd": { "type": ["number", "null"] },
        "volume_h24": { "type": ["number", "null"] },
        "trades_h24": { "type": ["integer", "null"], "minimum": 0 },
        "price_usd": { "type": ["number", "null"] },
        "price_change_h24": { "type": ["number", "null"] },
        "fdv": { "type": ["number", "null"] },
        "first_pair_at": { "type": ["string", "null"], "format": "date-time" },
        "top10_share": {
          "$comment": "Share of CIRCULATING supply — total supply less everything sitting in a burn address — held by the ten largest live holders on holder page 1. Burn holders are excluded from both the numerator and the supply it divides, because burned tokens are neither held nor sellable; what was burned is reported separately as burned_share.",
          "type": ["number", "null"], "minimum": 0, "maximum": 1
        },
        "top10_share_ex_pools": {
          "$comment": "Same measure over the ten largest holders that are also not a DexScreener pair, a project vault or locker, or a pool contract (the Uniswap v4 PoolManager singleton holds v4 liquidity under its own address and never appears in pairs).",
          "type": ["number", "null"], "minimum": 0, "maximum": 1
        },
        "burned_share": {
          "$comment": "Share of total supply in burn addresses on holder page 1. Absent from files written before this field existed; a null means the read did not determine it.",
          "type": ["number", "null"], "minimum": 0, "maximum": 1
        },
        "top10_as_of": { "type": ["string", "null"], "format": "date-time" },
        "launchpad": {
          "$comment": "via 'shared-factory' with shared: true means the creator is infrastructure many projects deploy through, so the slug names the operator, not the launcher of this token: read it as 'via Doppler (LONG)', never as 'launched by LONG'.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["slug", "via", "address"],
              "properties": {
                "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "via": { "enum": ["factory", "creator", "shared-factory"] },
                "address": { "$ref": "shared#/$defs/address" },
                "shared": { "type": "boolean" }
              }
            },
            { "type": "null" }
          ]
        },
        "rialto": {
          "oneOf": [{ "$ref": "#/$defs/rialtoMarket" }, { "type": "null" }]
        },
        "pair_asset": {
          "oneOf": [{ "$ref": "#/$defs/pairAsset" }, { "type": "null" }]
        },
        "volume_disagreement": {
          "oneOf": [{ "$ref": "#/$defs/volumeDisagreement" }, { "type": "null" }]
        },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/pullStepError" } }
      }
    },
    "rialtoPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool_id", "base", "target", "last_price", "base_volume_24h", "target_volume_24h", "volume_24h_usd"],
      "properties": {
        "pool_id": { "type": ["string", "null"] },
        "base": { "$ref": "shared#/$defs/address" },
        "target": { "$ref": "shared#/$defs/address" },
        "last_price": { "type": ["number", "null"] },
        "base_volume_24h": { "type": ["number", "null"], "minimum": 0 },
        "target_volume_24h": { "type": ["number", "null"], "minimum": 0 },
        "volume_24h_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "rialtoMarket": {
      "$comment": "Rialto ticker cross-check. volume_24h_usd is Rialto's own published 24h USD volume for the whole token, read from liquidity/spreads, and is the only figure comparable with the DexScreener total in volume_h24. The per-pair volume_24h_usd figures under pairs[] are supporting detail: the router indexes only some of a token's pools and prices only those legs whose counter-asset is stable, ETH or WETH, so they never sum to the token's day. When Rialto publishes no figure, volume_24h_usd is null, volume_note says so, and volume_disagreement stays null.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pairs", "volume_24h_usd", "volume_note", "as_of", "source_url"],
      "properties": {
        "pairs": { "type": "array", "items": { "$ref": "#/$defs/rialtoPair" } },
        "volume_24h_usd": { "type": ["number", "null"], "minimum": 0 },
        "volume_note": { "type": ["string", "null"] },
        "as_of": { "type": "string", "format": "date-time" },
        "source_url": { "type": "string", "format": "uri" }
      }
    },
    "pairAsset": {
      "$comment": "The tokenized stock or ETF a name is paired with. tokenized_shares is the asset explorer's own share count (value / price) — a size, not a holder count.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "name", "address", "category", "tokenized_value_usd", "tokenized_shares", "change_7d", "source_url"],
      "properties": {
        "ticker": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "address": { "oneOf": [{ "$ref": "shared#/$defs/address" }, { "type": "null" }] },
        "category": { "type": ["string", "null"] },
        "tokenized_value_usd": { "type": ["number", "null"], "minimum": 0 },
        "tokenized_shares": { "type": ["number", "null"], "minimum": 0 },
        "change_7d": { "type": ["number", "null"] },
        "source_url": { "type": "string", "format": "uri" }
      }
    },
    "volumeDisagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dexscreener_usd", "rialto_usd"],
      "properties": {
        "dexscreener_usd": { "type": "number", "minimum": 0 },
        "rialto_usd": { "type": "number", "minimum": 0 }
      }
    },
    "lpLock": {
      "$comment": "locked_share 0 is an assertion that nothing is locked, so it is written only when every LP holder read is a plain account. A holder that could be a locker this run has not located leaves the share null with `reason` saying so.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pair", "locked_share", "holder_kind", "reason"],
      "properties": {
        "pair": { "type": ["string", "null"] },
        "locked_share": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "holder_kind": { "enum": ["burn", "locker", "burn-and-locker", "none", null] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "pulledStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pulled_at", "mint", "renounced", "lp", "errors"],
      "properties": {
        "pulled_at": { "type": "string", "format": "date-time" },
        "mint": { "enum": ["owner-can-mint", "no-mint-function", "unknown"] },
        "renounced": { "type": ["boolean", "null"] },
        "lp": { "type": "array", "items": { "$ref": "#/$defs/lpLock" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/pullStepError" } }
      }
    },
    "activityAddress": {
      "$comment": "txns_24h counts transactions TO the address in the last 24 hours, walked newest-first and capped at 40 pages. launches_24h is the subset whose method name starts with launch/create/deploy/mint, and is null for any address the census does not call a factory.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address", "label", "role", "transactions_count", "token_transfers_count",
        "last_tx_at", "last_method", "txns_24h", "launches_24h", "errors"
      ],
      "properties": {
        "address": { "$ref": "shared#/$defs/address" },
        "label": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "transactions_count": { "type": ["integer", "null"], "minimum": 0 },
        "token_transfers_count": { "type": ["integer", "null"], "minimum": 0 },
        "last_tx_at": { "type": ["string", "null"], "format": "date-time" },
        "last_method": { "type": ["string", "null"] },
        "txns_24h": { "type": ["integer", "null"], "minimum": 0 },
        "launches_24h": { "type": ["integer", "null"], "minimum": 0 },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/pullStepError" } }
      }
    },
    "pulledActivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pulled_at", "addresses", "last_activity_at", "txns_24h", "launches_24h"],
      "properties": {
        "pulled_at": { "type": "string", "format": "date-time" },
        "addresses": { "type": "array", "items": { "$ref": "#/$defs/activityAddress" } },
        "last_activity_at": { "type": ["string", "null"], "format": "date-time" },
        "txns_24h": { "type": ["integer", "null"], "minimum": 0 },
        "launches_24h": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
