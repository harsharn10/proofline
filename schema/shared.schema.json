{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shared",
  "$defs": {
    "category": { "$comment": "Derived from the tree leaf label (schema/taxonomy.json); transitional, removed once every consumer reads tree.primary.", "enum": ["Bonding-curve launchpad","Programmable-hook launchpad","Stock-paired token factory","Uniswap-pool launchpad","NFT-gated launchpad","Launchpad · mechanism not classified","Launchpad-graduated token","Native AMM","Imported AMM","Trading aggregator","MEV-redistribution hook","Native perpetuals exchange","Imported perpetuals venue","Proprietary-liquidity AMM","Trading frontend / bot","Lending primitive","Morpho vault curator","Isolated lending market","Collateralized debt protocol","Credit aggregation layer","RWA lending market","Uncollateralized credit protocol","Stock-token issuer","Stock-paired token","Redeemable RWA basket","Fee-funded RWA distributor","RWA index vault","Synthetic asset protocol","Reserve-backed currency","Tokenized advertising market","Agent launch platform","Agent execution platform","Agent identity service","Autonomous-agent product","Token-bound treasury NFT","NFT fee-claim product","NFT marketplace","Prediction market","Options market","Savings vault","Liquidity manager","Yield allocator","Fee-routing protocol","Gamified yield product","Private transfer protocol","Token and liquidity locker","Market scanner","Naming service","Machine-payment tooling","Chain and sequencer","Bridge infrastructure","Oracle infrastructure","Stablecoin infrastructure","RPC and account-abstraction infrastructure","Custody infrastructure","Chain analytics"] },
    "entityKind": { "enum": ["protocol","application","token","infrastructure","tool","collection","unknown"] },
    "chainScope": { "enum": ["robinhood-native","multichain","cross-chain","unknown"] },
    "identityStatus": { "enum": ["verified","provisional","conflicted"] },
    "taxonomyDomain": { "enum": ["launch","rwa-products","trading","yield","agents","tooling","credit","nft-treasury","markets","privacy","chain-infra"] },
    "taxonomyLeaf": { "$comment": "Keys of schema/taxonomy.json leaves.", "enum": ["launch/bonding-curve","launch/hook-programmable","launch/stock-paired-factory","launch/uni-pool-launch","launch/nft-gated-launch","launch/other-pad","launch/graduation-token","trading/amm-native","trading/amm-imported","trading/aggregator","trading/hook-mev","trading/perps-native","trading/perps-imported","trading/prop-amm","trading/exec-frontend","credit/lending-primitive","credit/morpho-curator","credit/isolated-money-market","credit/cdp","credit/credit-overlay","credit/rwa-lending","credit/uncollateralized","rwa-products/stock-token-issuer","rwa-products/stock-paired-token","rwa-products/redeemable-basket","rwa-products/tax-distributor","rwa-products/index-vault","rwa-products/synthetic-asset","rwa-products/reserve-currency","rwa-products/ad-space","agents/agent-launch-layer","agents/agent-execution","agents/agent-identity","agents/agent-product","nft-treasury/token-bound-nft","nft-treasury/nft-fee-claim","nft-treasury/nft-marketplace","markets/prediction","markets/options","yield/savings-vault","yield/lp-manager","yield/allocator","yield/fee-router","yield/gamified-mining","privacy/private-transfer","tooling/locker","tooling/scanner","tooling/names","tooling/machine-payments","chain-infra/l2-sequencer","chain-infra/bridge","chain-infra/oracle","chain-infra/stablecoin","chain-infra/rpc-aa","chain-infra/custody","chain-infra/analytics"] },
    "mechanismTag": { "enum": ["bonding-curve","amm","orderbook","lending","collateralized-debt","vault","index","rwa","stock-paired","agent","execution","nft","fee-routing","bridge","oracle","privacy","analytics","launchpad","derivatives","stablecoin","other"] },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["aliases","symbols","entity_kind","chain_scope","status"],
      "properties": {
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "symbols": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "entity_kind": { "$ref": "#/$defs/entityKind" },
        "chain_scope": { "$ref": "#/$defs/chainScope" },
        "status": { "$ref": "#/$defs/identityStatus" },
        "conflict_ids": { "type": "array", "items": { "type": "string", "pattern": "^CON-[a-z0-9-]+$" }, "uniqueItems": true }
      },
      "if": { "properties": { "status": { "const": "conflicted" } } },
      "then": { "required": ["conflict_ids"], "properties": { "conflict_ids": { "minItems": 1 } } },
      "else": { "properties": { "conflict_ids": { "maxItems": 0 } } }
    },
    "metricKind": { "enum": ["tvl","volume_24h","fees_24h","revenue_24h","market_cap","holders"] },
    "chain": { "enum": ["robinhood-chain","arbitrum-one","ethereum","base","solana","hyperliquid","other"] },
    "address": { "type": "string", "pattern": "^(0x[0-9a-fA-F]{40}|[1-9A-HJ-NP-Za-km-z]{32,44}|not-verified)$" },
    "role": { "enum": ["token","factory","router","vault","proxy","implementation","admin","multisig","timelock","other"] },
    "deployment": { "type": "object", "additionalProperties": false, "required": ["label","chain","address","role","verified","sources"],
      "properties": {
        "label": { "type": "string" },
        "chain": { "$ref": "#/$defs/chain" },
        "address": { "$ref": "#/$defs/address" },
        "issuer": { "type": "string" },
        "ticker": { "type": "string" },
        "role": { "$ref": "#/$defs/role" },
        "verified": { "type": "boolean" },
        "sources": { "type": "array", "items": { "type": "string", "pattern": "^S[1-9][0-9]*$" }, "uniqueItems": true }
      },
      "if": { "required": ["verified"], "properties": { "verified": { "const": true } } },
      "then": { "properties": { "address": { "pattern": "^(0x[0-9a-fA-F]{40}|[1-9A-HJ-NP-Za-km-z]{32,44})$" }, "sources": { "minItems": 1 } } } }
  }
}
