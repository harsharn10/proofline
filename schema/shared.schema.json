{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shared",
  "$defs": {
    "category": { "enum": ["Launchpad","Aggregator","Stock-paired token","Fee-routing protocol","NFT / treasury","RWA distributor","RWA baskets","CDP","Agent / execution","Prediction market","Index vault","Lending","Options","Yield","Perpetuals","Oracle / infra","Stablecoin","Scanner / tooling"] },
    "entityKind": { "enum": ["protocol","application","token","infrastructure","tool","collection","unknown"] },
    "chainScope": { "enum": ["robinhood-native","multichain","cross-chain","unknown"] },
    "identityStatus": { "enum": ["verified","provisional","conflicted"] },
    "taxonomyDomain": { "enum": ["launch","rwa-products","trading","yield","agents","tooling","credit","nft-treasury","markets","privacy","chain-infra"] },
    "mechanismTag": { "enum": ["bonding-curve","amm","orderbook","lending","collateralized-debt","vault","index","rwa","stock-paired","agent","execution","nft","fee-routing","bridge","oracle","privacy","analytics","launchpad","derivatives","stablecoin","other"] },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["aliases","symbols","entity_kind","chain_scope","status"],
      "properties": {
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "symbols": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "entity_kind": { "$ref": "#/$defs/entityKind" },
        "chain_scope": { "$ref": "#/$defs/chainScope" },
        "status": { "$ref": "#/$defs/identityStatus" },
        "conflict_ids": { "type": "array", "items": { "type": "string", "pattern": "^CON-[a-z0-9-]+$" }, "uniqueItems": true }
      },
      "if": { "properties": { "status": { "const": "conflicted" } } },
      "then": { "required": ["conflict_ids"], "properties": { "conflict_ids": { "minItems": 1 } } },
      "else": { "properties": { "conflict_ids": { "maxItems": 0 } } }
    },
    "metricKind": { "enum": ["tvl","volume_24h","fees_24h","revenue_24h","market_cap","holders"] },
    "chain": { "enum": ["robinhood-chain","arbitrum-one","ethereum","base","solana","hyperliquid","other"] },
    "address": { "type": "string", "pattern": "^(0x[0-9a-fA-F]{40}|[1-9A-HJ-NP-Za-km-z]{32,44}|not-verified)$" },
    "role": { "enum": ["token","factory","router","vault","proxy","implementation","admin","multisig","timelock","other"] },
    "deployment": { "type": "object", "additionalProperties": false, "required": ["label","chain","address","role","verified","sources"],
      "properties": {
        "label": { "type": "string" },
        "chain": { "$ref": "#/$defs/chain" },
        "address": { "$ref": "#/$defs/address" },
        "issuer": { "type": "string" },
        "ticker": { "type": "string" },
        "role": { "$ref": "#/$defs/role" },
        "verified": { "type": "boolean" },
        "sources": { "type": "array", "items": { "type": "string", "pattern": "^S[1-9][0-9]*$" }, "uniqueItems": true }
      },
      "if": { "required": ["verified"], "properties": { "verified": { "const": true } } },
      "then": { "properties": { "address": { "pattern": "^(0x[0-9a-fA-F]{40}|[1-9A-HJ-NP-Za-km-z]{32,44})$" }, "sources": { "minItems": 1 } } } }
  }
}
