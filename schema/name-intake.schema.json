{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "name-intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","candidate_id","observed_at","researcher","slug","name","identity","taxonomy","lifecycle","official_links","sources","reproductions","claims","requirements","conflicts","possible_matches","qualifying"],
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^SRC-[1-9][0-9]*$" },
    "claimId": { "type": "string", "pattern": "^CLM-[1-9][0-9]*$" },
    "reproductionId": { "type": "string", "pattern": "^REP-[1-9][0-9]*$" },
    "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceId" }, "uniqueItems": true },
    "claimRefs": { "type": "array", "items": { "$ref": "#/$defs/claimId" }, "uniqueItems": true },
    "reproductionRefs": { "type": "array", "items": { "$ref": "#/$defs/reproductionId" }, "uniqueItems": true },
    "link": {
      "type": "object", "additionalProperties": false,
      "required": ["kind","url","authenticity","source_ids"],
      "properties": {
        "kind": { "enum": ["site","app","docs","whitepaper","x","github","telegram","discord","other"] },
        "url": { "type": "string", "format": "uri" },
        "authenticity": { "enum": ["confirmed","unconfirmed","conflicted"] },
        "source_ids": { "$ref": "#/$defs/sourceRefs", "minItems": 1 }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id","url","publisher","kind","authority","authenticity","published_at","accessed_at","hash","archive_url"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" },
        "url": { "type": "string", "format": "uri" },
        "publisher": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["official-site","docs","whitepaper","social","explorer","repository","audit","announcement","third-party-data","news","other"] },
        "authority": { "enum": ["onchain","primary","independent","aggregator","social","unknown"] },
        "authenticity": { "enum": ["confirmed","unconfirmed","conflicted"] },
        "published_at": { "type": ["string","null"], "format": "date-time" },
        "accessed_at": { "type": "string", "format": "date-time" },
        "hash": { "type": ["string","null"] },
        "archive_url": { "type": ["string","null"], "format": "uri" }
      }
    },
    "reproduction": {
      "type": "object", "additionalProperties": false,
      "required": ["id","method","source_ids","checked_at","result"],
      "properties": {
        "id": { "$ref": "#/$defs/reproductionId" },
        "method": { "enum": ["explorer-rpc","explorer-ui","official-crosslink","repository-crosslink","document-scope","api","other"] },
        "source_ids": { "$ref": "#/$defs/sourceRefs", "minItems": 1 },
        "chain_id": { "type": "integer", "minimum": 1 },
        "checked_at": { "type": "string", "format": "date-time" },
        "result": { "type": "string", "minLength": 1 }
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id","field","value","class","source_ids","reproduction_ids","observed_at"],
      "properties": {
        "id": { "$ref": "#/$defs/claimId" },
        "field": { "enum": ["identity.name","identity.alias","identity.symbol","identity.handle","identity.domain","taxonomy.category","taxonomy.entity-kind","taxonomy.chain-scope","taxonomy.primary-domain","taxonomy.mechanism-tag","lifecycle","product.mechanism","deployment.address","deployment.role","control.privileged-role","security.audit","team.identity","economics.metric","activity.status","communications.status","relationship","other"] },
        "value": {},
        "class": { "enum": ["verified","claim","disputed","unknown"] },
        "source_ids": { "$ref": "#/$defs/sourceRefs" },
        "reproduction_ids": { "$ref": "#/$defs/reproductionRefs" },
        "observed_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        { "if": { "properties": { "class": { "const": "unknown" } } }, "then": { "properties": { "source_ids": { "maxItems": 0 }, "reproduction_ids": { "maxItems": 0 } } }, "else": { "properties": { "source_ids": { "minItems": 1 } } } },
        { "if": { "properties": { "class": { "const": "verified" } } }, "then": { "properties": { "reproduction_ids": { "minItems": 1 } } } }
      ]
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["status","claim_ids","note"],
      "properties": {
        "status": { "enum": ["substantiated","claimed","conflicted","not-found","not-applicable"] },
        "claim_ids": { "$ref": "#/$defs/claimRefs" },
        "note": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "status": { "enum": ["not-found","not-applicable"] } } },
      "then": { "properties": { "claim_ids": { "maxItems": 0 } } },
      "else": { "properties": { "claim_ids": { "minItems": 1 } } }
    },
    "qualifyingTest": {
      "type": "object", "additionalProperties": false,
      "required": ["status","claim_ids","note"],
      "properties": {
        "status": { "enum": ["pass","fail","unknown"] },
        "claim_ids": { "$ref": "#/$defs/claimRefs" },
        "note": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "status": { "const": "unknown" } } },
      "then": { "properties": { "claim_ids": { "maxItems": 0 } } },
      "else": { "properties": { "claim_ids": { "minItems": 1 } } }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["id","field","claim_ids","status","resolution"],
      "properties": {
        "id": { "type": "string", "pattern": "^CON-[a-z0-9-]+$" },
        "field": { "type": "string", "minLength": 1 },
        "claim_ids": { "$ref": "#/$defs/claimRefs", "minItems": 2 },
        "status": { "enum": ["open","resolved"] },
        "resolution": {
          "type": ["object","null"], "additionalProperties": false,
          "required": ["winning_claim_ids","reproduction_ids","rationale","resolver","resolved_at"],
          "properties": {
            "winning_claim_ids": { "$ref": "#/$defs/claimRefs", "minItems": 1 },
            "reproduction_ids": { "$ref": "#/$defs/reproductionRefs", "minItems": 1 },
            "rationale": { "type": "string", "minLength": 1 },
            "resolver": { "type": "string", "minLength": 1, "not": { "const": "grok-bot" } },
            "resolved_at": { "type": "string", "format": "date-time" }
          }
        }
      },
      "if": { "properties": { "status": { "const": "resolved" } } },
      "then": { "properties": { "resolution": { "type": "object" } } },
      "else": { "properties": { "resolution": { "type": "null" } } }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "candidate_id": { "type": "string", "pattern": "^NAME-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "researcher": { "const": "grok-bot" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "identity": { "$ref": "shared#/$defs/identity" },
    "taxonomy": {
      "type": "object", "additionalProperties": false,
      "required": ["category","primary_domain","mechanism_tags"],
      "properties": {
        "category": { "$ref": "shared#/$defs/category" },
        "primary_domain": { "$ref": "shared#/$defs/taxonomyDomain" },
        "mechanism_tags": { "type": "array", "minItems": 1, "items": { "$ref": "shared#/$defs/mechanismTag" }, "uniqueItems": true }
      }
    },
    "lifecycle": { "enum": ["mainnet","beta","announced","inactive","testnet-only","unknown"] },
    "official_links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "reproductions": { "type": "array", "items": { "$ref": "#/$defs/reproduction" } },
    "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["identity","product","deployment","control","security","team","economics","activity","communications"],
      "properties": {
        "identity": { "$ref": "#/$defs/requirement" },
        "product": { "$ref": "#/$defs/requirement" },
        "deployment": { "$ref": "#/$defs/requirement" },
        "control": { "$ref": "#/$defs/requirement" },
        "security": { "$ref": "#/$defs/requirement" },
        "team": { "$ref": "#/$defs/requirement" },
        "economics": { "$ref": "#/$defs/requirement" },
        "activity": { "$ref": "#/$defs/requirement" },
        "communications": { "$ref": "#/$defs/requirement" }
      }
    },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
    "possible_matches": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slug","signals","note"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "signals": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["same-normalized-name","shared-domain","shared-handle","shared-address","shared-deployer","shared-repository","ticker-only","other"] } },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "qualifying": {
      "type": "object", "additionalProperties": false,
      "required": ["deployed_on_chain","native_play","citable","research_story"],
      "properties": {
        "deployed_on_chain": { "$ref": "#/$defs/qualifyingTest" },
        "native_play": { "$ref": "#/$defs/qualifyingTest" },
        "citable": { "$ref": "#/$defs/qualifyingTest" },
        "research_story": { "$ref": "#/$defs/qualifyingTest" }
      }
    }
  }
}
