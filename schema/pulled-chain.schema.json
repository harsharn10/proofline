{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pulled-chain",
  "title": "Rialto Analytics chain facts",
  "$comment": "Machine-owned content/pulled/chain.yaml. Every nullable field has a sibling block errors array; discoveryDocument validates content/pulled/discovery.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pulled_at", "tvl", "economics", "activity", "tokenization", "transfers", "mintburn"],
  "properties": {
    "pulled_at": { "type": "string", "format": "date-time" },
    "tvl": { "$ref": "#/$defs/tvl" },
    "economics": { "$ref": "#/$defs/economics" },
    "activity": { "$ref": "#/$defs/activity" },
    "tokenization": { "$ref": "#/$defs/tokenization" },
    "transfers": { "$ref": "#/$defs/transfers" },
    "mintburn": { "$ref": "#/$defs/mintburn" }
  },
  "$defs": {
    "nullableNumber": { "type": ["number", "null"] },
    "nullableNonnegative": { "type": ["number", "null"], "minimum": 0 },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "message"],
      "properties": {
        "step": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "sourceFields": {
      "type": "object",
      "required": ["source_url", "errors"],
      "properties": {
        "source_url": { "type": "string", "format": "uri" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "tvl": {
      "allOf": [{ "$ref": "#/$defs/sourceFields" }],
      "type": "object",
      "additionalProperties": false,
      "required": ["total_tracked_usd", "stablecoin_usd", "asset_supply_usd", "by_category", "by_protocol", "source_url", "errors"],
      "properties": {
        "total_tracked_usd": { "$ref": "#/$defs/nullableNonnegative" },
        "stablecoin_usd": { "$ref": "#/$defs/nullableNonnegative" },
        "asset_supply_usd": { "$ref": "#/$defs/nullableNonnegative" },
        "by_category": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["category", "tvl_usd"],
            "properties": { "category": { "type": "string", "minLength": 1 }, "tvl_usd": { "type": "number", "minimum": 0 } }
          }
        },
        "by_protocol": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["protocol", "category", "tvl_usd", "total_tracked_tvl", "share"],
            "properties": {
              "protocol": { "type": "string", "minLength": 1 },
              "category": { "type": "string", "minLength": 1 },
              "tvl_usd": { "type": "number", "minimum": 0 },
              "total_tracked_tvl": { "$ref": "#/$defs/nullableNonnegative" },
              "share": { "$ref": "#/$defs/nullableNumber" }
            }
          }
        },
        "source_url": { "type": "string", "format": "uri" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "economics": {
      "type": "object", "additionalProperties": false,
      "required": ["cum_fee_revenue_usd", "cum_gross_profit_usd", "gross_margin_pct", "latest_day", "source_url", "errors"],
      "properties": {
        "cum_fee_revenue_usd": { "$ref": "#/$defs/nullableNonnegative" },
        "cum_gross_profit_usd": { "$ref": "#/$defs/nullableNumber" },
        "gross_margin_pct": { "$ref": "#/$defs/nullableNumber" },
        "latest_day": { "type": ["string", "null"], "format": "date" },
        "source_url": { "type": "string", "format": "uri" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "rollup": {
      "type": "object", "additionalProperties": false,
      "required": ["latest", "sum_7d", "sum_30d"],
      "properties": {
        "latest": { "$ref": "#/$defs/nullableNonnegative" },
        "sum_7d": { "$ref": "#/$defs/nullableNonnegative" },
        "sum_30d": { "$ref": "#/$defs/nullableNonnegative" }
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["latest_day", "daily_volume_usd", "active_wallets", "tx_count", "source_url", "errors"],
      "properties": {
        "latest_day": { "type": ["string", "null"], "format": "date" },
        "daily_volume_usd": { "$ref": "#/$defs/rollup" },
        "active_wallets": { "$ref": "#/$defs/rollup" },
        "tx_count": { "$ref": "#/$defs/rollup" },
        "source_url": { "type": "string", "format": "uri" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "tokenization": {
      "type": "object", "additionalProperties": false,
      "required": ["assets", "value_usd", "mint_24h_usd", "net_minting", "source_url", "errors"],
      "properties": {
        "assets": { "type": ["integer", "null"], "minimum": 0 },
        "value_usd": { "$ref": "#/$defs/nullableNonnegative" },
        "mint_24h_usd": { "$ref": "#/$defs/nullableNonnegative" },
        "net_minting": { "type": ["boolean", "null"] },
        "source_url": { "type": "string", "format": "uri" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "transfers": {
      "type": "object", "additionalProperties": false,
      "required": ["d1_volume_usd", "d7_volume_usd", "all_time_transfers", "source_url", "errors"],
      "properties": {
        "d1_volume_usd": { "$ref": "#/$defs/nullableNonnegative" },
        "d7_volume_usd": { "$ref": "#/$defs/nullableNonnegative" },
        "all_time_transfers": { "type": ["integer", "null"], "minimum": 0 },
        "source_url": { "type": "string", "format": "uri" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "mintburn": {
      "type": "object", "additionalProperties": false,
      "required": ["mint_24h_usd", "cumulative_net_usd", "source_url", "errors"],
      "properties": {
        "mint_24h_usd": { "$ref": "#/$defs/nullableNonnegative" },
        "cumulative_net_usd": { "$ref": "#/$defs/nullableNumber" },
        "source_url": { "type": "string", "format": "uri" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "discoveryDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["pulled_at", "candidates", "errors"],
      "properties": {
        "pulled_at": { "type": "string", "format": "date-time" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["address", "symbol", "name", "first_seen", "rialto_volume_24h_usd", "dexscreener_liquidity_usd", "source_urls"],
            "properties": {
              "address": { "$ref": "shared#/$defs/address" },
              "symbol": { "type": ["string", "null"] },
              "name": { "type": ["string", "null"] },
              "first_seen": { "type": "string", "format": "date-time" },
              "rialto_volume_24h_usd": { "$ref": "#/$defs/nullableNonnegative" },
              "dexscreener_liquidity_usd": { "$ref": "#/$defs/nullableNonnegative" },
              "source_urls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri" } }
            }
          }
        },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    }
  }
}
