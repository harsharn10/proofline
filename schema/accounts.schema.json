{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "accounts",
  "type": "array",
  "items": { "type": "object", "additionalProperties": false, "required": ["handle","tier"],
    "properties": {
      "handle": { "type": "string", "pattern": "^@[A-Za-z0-9_]{1,15}$" },
      "name": { "type": "string" },
      "tier": { "enum": ["top","watch","downweight","skip"] },
      "role": { "enum": ["project","alpha","kol","data","infra","media"] },
      "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "followers": { "type": "integer", "minimum": 0 },
      "note": { "type": "string" }
    } }
}
