# Copy to .env.local (gitignored). Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public site URL used in digest links, and the profile path prefix on that site.
SITE_URL=http://localhost:8080
PROFILE_PATH=/n/

# /review controller. Use a long random value for the controller key and a fine-grained GitHub token
# scoped only to harsharn10/proofline with Contents read/write. Never expose either value client-side.
REVIEW_ADMIN_TOKEN=
REVIEW_GITHUB_TOKEN=
REVIEW_GITHUB_REPO=harsharn10/proofline
REVIEW_GITHUB_BRANCH=main
